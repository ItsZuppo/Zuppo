# ==============================================================================
# AMBIBITES ENVIRONMENT CONFIGURATION
# Copy these values into your .env.local file after creating a Supabase project
# ==============================================================================

# Supabase Settings (Get from: Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Razorpay Test Mode Keys (For payment gateway integration later)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=your_secret_key

# Ola Maps / MapLibre API Key (For Ambikapur route tracking)
NEXT_PUBLIC_OLA_MAPS_API_KEY=your_ola_maps_key

# Cloudflare R2 Storage (Zero Egress Image CDN)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ambibite
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-yoursubdomain.r2.dev

# Brevo Transactional Email (OTP & Verification)
BREVO_API_KEY=your_brevo_v3_api_key
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=zuuppo@gmail.com
BREVO_SENDER_NAME=zuppo

# Optional trusted owner email. Customer registration must pass email OTP first.
ADMIN_BOOTSTRAP_EMAIL=
# Local demo staff credentials only, never production
ENABLE_DEMO_LOGIN=false
